{"nodes": [{"id": "docs_superpowers_plans_2026_07_25_client_source_install", "label": "Client-side source-kind package install (Phase 4) implementation plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-07-25-client-source-install.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_client_source_install", "label": "Client-side kind=source package install (shallow clone + local build + atomic swap)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-25-client-source-install.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_repo_url_semantics_fix", "label": "Source.repo_url redefined as git-clonable remote (not a web page URL)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-07-25-client-source-install.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rationale_sparse_checkout_deferred", "label": "Shallow clone whole repo instead of true git sparse-checkout for source packages", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-07-25-client-source-install.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "git2/libgit2's sparse-checkout support is less mature than the git CLI's; since source-kind repos are expected to be small text files, trading bandwidth for a simpler, reliable API is an accepted simplification until large source repos make it worth revisiting."}, {"id": "rationale_drop_privileges_for_build", "label": "drop_privileges_for_build is the load-bearing safeguard against root-executed build commands", "file_type": "rationale", "source_file": "docs/superpowers/plans/2026-07-25-client-source-install.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contri